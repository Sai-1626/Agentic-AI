{
  "name": "Video Creator Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "video-agent",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "wc-webhook",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [100, 200]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "assign-prompt",
              "name": "prompt",
              "value": "={{ $json.body.prompt || $json.body.topic || 'Make a video about artificial intelligence' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "wc-set-vars",
      "name": "Set Variables",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [300, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://python-worker:5000/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"prompt\": \"{{ $json.prompt }}\"\n}",
        "options": {
          "timeout": 180000
        }
      },
      "id": "wc-py-exec",
      "name": "Generate Video Pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [550, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "wc-respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [800, 200]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [[{ "node": "Set Variables", "type": "main", "index": 0 }]]
    },
    "Set Variables": {
      "main": [[{ "node": "Generate Video Pipeline", "type": "main", "index": 0 }]]
    },
    "Generate Video Pipeline": {
      "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
