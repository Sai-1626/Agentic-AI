    {
      "parameters": {
        "jsCode": "// Node 4: Parse Planning JSON\nconst plan = $input.first().json;\nreturn [{\n  json: {\n    topic: plan.topic || 'Artificial Intelligence in Education',\n    target_audience: plan.target_audience || 'Students',\n    platform: plan.platform || 'Instagram Reels',\n    duration: plan.duration || 60,\n    tone: plan.tone || 'Educational',\n    style: plan.style || 'Short-form Video',\n    main_message: plan.main_message || 'AI is transforming education',\n    hook_strategy: plan.hook_strategy || 'Ask a question'\n  }\n}];"
      },
      "id": "node-4-parse-json",
      "name": "Code — Parse Planning JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 300]
    },
