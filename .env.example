# ==============================================================================
# Agentic AI Social Media Video Automation - Environment Configuration
# ==============================================================================

# LLM Configuration (Ollama / OpenAI / Claude)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=mistral
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# Visual Stock APIs (At least one recommended, or leave blank for auto-synthesis)
PEXELS_API_KEY=your_pexels_api_key_here
PIXABAY_API_KEY=your_pixabay_api_key_here
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Text-to-Speech (piper, google, elevenlabs, local)
TTS_ENGINE=piper
PIPER_VOICE_MODEL=en_US-lessac-medium
GOOGLE_APPLICATION_CREDENTIALS=config/google_credentials.json
GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Whisper Speech-to-Text
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# Video Rendering Specifications
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30

# Social Media Publishing (Set DRY_RUN_PUBLISHING=false when live credentials are set)
DRY_RUN_PUBLISHING=true
YOUTUBE_CLIENT_SECRETS_FILE=config/client_secrets.json
YOUTUBE_CREDENTIALS_FILE=config/youtube_token.json
YOUTUBE_DEFAULT_PRIVACY=unlisted

# Meta / Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=your_instagram_user_access_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id_here
INSTAGRAM_GRAPH_VERSION=v21.0
HOSTED_MEDIA_BASE_URL=http://localhost:5000/files

# Scheduling & Timezone
DEFAULT_TIMEZONE=Asia/Kolkata

# Email Notifications (SMTP / Gmail)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
NOTIFICATION_EMAIL_TO=recipient@example.com
NOTIFICATION_EMAIL_FROM=your_email@gmail.com

# Service Ports & N8N
PORT=5000
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=password123
N8N_WEBHOOK_URL=http://localhost:5678/webhook/video-agent
